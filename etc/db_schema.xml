<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_payment">
        <column name="cardgatefee_incl_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Incl Tax" default="0.0000" />
        <column name="base_cardgatefee_incl_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Incl Tax" default="0.0000" />
        <column name="base_cardgatefee_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Excl Tax Amount" default="0.0000" />
        <column name="base_cardgatefee_tax_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Tax Amount" default="0.0000" />
        <column name="cardgatefee_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Excl Tax Amount" default="0.0000" />
        <column name="cardgatefee_tax_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Tax Amount" default="0.0000" />
    </table>

    <table name="sales_order">
        <column name="cardgatefee_incl_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Incl Tax" default="0.0000" />
        <column name="base_cardgatefee_incl_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Incl Tax" default="0.0000" />
        <column name="base_cardgatefee_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Excl Tax Amount" default="0.0000" />
        <column name="base_cardgatefee_cancelled" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Excl Tax Cancelled" default="0.0000" />
        <column name="base_cardgatefee_invoiced" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Excl Tax Invoiced" default="0.0000" />
        <column name="base_cardgatefee_refunded" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Excl Tax Refunded" default="0.0000" />
        <column name="base_cardgatefee_tax_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Tax Amount" default="0.0000" />
        <column name="base_cardgatefee_tax_refunded" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Tax Refunded" default="0.0000" />
        <column name="cardgatefee_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Excl Tax Amount" default="0.0000" />
        <column name="cardgatefee_cancelled" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Excl Tax Cancelled" default="0.0000" />
        <column name="cardgatefee_invoiced" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Excl Tax Invoiced" default="0.0000" />
        <column name="cardgatefee_refunded" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Excl Tax Refunded" default="0.0000" />
        <column name="cardgatefee_tax_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Tax Amount" default="0.0000" />
        <column name="cardgatefee_tax_refunded" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Tax Refunded" default="0.0000" />
    </table>

    <table name="sales_invoice">
        <column name="cardgatefee_incl_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Incl Tax" default="0.0000" />
        <column name="base_cardgatefee_incl_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Incl Tax" default="0.0000" />
        <column name="base_cardgatefee_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Excl Tax Amount" default="0.0000" />
        <column name="base_cardgatefee_tax_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Base CardGate Fee Tax Amount" default="0.0000" />
        <column name="cardgatefee_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Excl Tax Amount" default="0.0000" />
        <column name="cardgatefee_tax_amount" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="CardGate Fee Tax Amount" default="0.0000" />
    </table>

    <table name="sales_order_payment">
        <column xsi:type="varchar" name="cardgate_paymentmethod" nullable="true" length="64" comment="CardGate PaymentMethod"/>
        <column xsi:type="varchar" name="cardgate_transaction" nullable="true" length="64" comment="CardGate TransactionID"/>
        <column xsi:type="int" name="cardgate_status" unsigned="true" nullable="true" comment="CardGate StatusCode" default="0"/>
        <column xsi:type="boolean" name="cardgate_testmode" nullable="true" default="false" comment="CardGate TestMode"/>
    </table>

    <table name="cardgate_subscription" resource="default" engine="innodb" comment="CardGate / CuroPayments Subscriptions">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="int" name="store_id" unsigned="true" nullable="true" comment="Store ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Originating Sales Order ID"/>
        <column xsi:type="varchar" name="increment_id" length="50" nullable="true" comment="Originating Order Increment ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Subscribed Product ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="true" comment="Subscribed Product SKU"/>
        <column xsi:type="varchar" name="name" length="255" nullable="true" comment="Subscribed Product Name"/>
        <column xsi:type="decimal" name="qty" scale="4" precision="12" nullable="false" default="1.0000" comment="Quantity"/>
        <column xsi:type="varchar" name="mandate_transaction_id" length="64" nullable="true" comment="Authorizing (mandate) transaction id"/>
        <column xsi:type="varchar" name="payment_method" length="64" nullable="true" comment="Magento payment method code"/>
        <column xsi:type="int" name="amount" unsigned="true" nullable="false" default="0" comment="Recurring amount in cents"/>
        <column xsi:type="int" name="shipping_amount" unsigned="true" nullable="false" default="0" comment="Recurring shipping amount in cents"/>
        <column xsi:type="varchar" name="currency" length="3" nullable="false" default="EUR" comment="Currency (ISO-4217)"/>
        <column xsi:type="int" name="interval_count" unsigned="true" nullable="false" default="1" comment="Interval count"/>
        <column xsi:type="varchar" name="interval_unit" length="10" nullable="false" default="month" comment="Interval unit (day/week/month/year)"/>
        <column xsi:type="varchar" name="status" length="20" nullable="false" default="active" comment="Status (active/paused/cancelled)"/>
        <column xsi:type="smallint" name="skip_next" unsigned="true" nullable="false" default="0" comment="Skip next billing cycle flag"/>
        <column xsi:type="int" name="cycles_billed" unsigned="true" nullable="false" default="0" comment="Number of cycles billed"/>
        <column xsi:type="varchar" name="last_transaction_id" length="64" nullable="true" comment="Last recurring transaction id"/>
        <column xsi:type="int" name="last_order_id" unsigned="true" nullable="true" comment="Last renewal Sales Order ID"/>
        <column xsi:type="smallint" name="failure_count" unsigned="true" nullable="false" default="0" comment="Consecutive failed billing attempts"/>
        <column xsi:type="varchar" name="last_error" length="255" nullable="true" comment="Last billing error"/>
        <column xsi:type="datetime" name="next_run_at" nullable="true" comment="Next scheduled billing date"/>
        <column xsi:type="datetime" name="last_run_at" nullable="true" comment="Last billing date"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="CARDGATE_SUBSCRIPTION_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="CARDGATE_SUBSCRIPTION_STATUS_NEXT_RUN_AT" indexType="btree">
            <column name="status"/>
            <column name="next_run_at"/>
        </index>
    </table>
</schema>
